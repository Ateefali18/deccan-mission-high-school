{
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/lookup",
      "destination": "/api/auth-lookup.js"
    },
    {
      "source": "/api/auth/request-otp",
      "destination": "/api/auth-request-otp.js"
    },
    {
      "source": "/api/auth/verify-otp",
      "destination": "/api/auth-verify-otp.js"
    },
    {
      "source": "/api/auth/reset-password",
      "destination": "/api/auth-reset-password.js"
    },
    {
      "source": "/api/v1/auth/request-otp",
      "destination": "/api/auth-request-otp.js"
    },
    {
      "source": "/api/v1/auth/verify-otp",
      "destination": "/api/auth-verify-otp.js"
    },
    {
      "source": "/api/v1/auth/reset-password",
      "destination": "/api/auth-reset-password.js"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
